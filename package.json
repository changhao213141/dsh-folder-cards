{
  "name": "dsh-folder-cards",
  "version": "0.2.0",
  "type": "module",
  "description": "Folder-style workspace cards for the DeepSeek Harness sidebar: two 3:4 portrait cards per row, each with a folder glyph, an optional inserted image, and its own session list with a back button.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "build.mjs",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "LICENSE",
    "README.md",
    "README.en.md",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/changhao213141/dsh-folder-cards.git"
  },
  "homepage": "https://github.com/changhao213141/dsh-folder-cards#readme",
  "bugs": {
    "url": "https://github.com/changhao213141/dsh-folder-cards/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "workspace",
    "cards",
    "cordis"
  ]
}
